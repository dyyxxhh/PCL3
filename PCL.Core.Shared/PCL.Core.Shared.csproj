<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(PclTorBundle)' != ''">
    <EmbeddedResource Include="$(PclTorBundle)" LogicalName="PCL.TorExpertBundle.tar.gz" />
  </ItemGroup>
  <Target Name="ValidateGameIntroPreviewInputs" BeforeTargets="PrepareResourceNames" Condition="'$(PclGameIntroClip)' != '' or '$(PclGameIntroAgent)' != ''">
    <Error Condition="'$(PclGameIntroClip)' == '' or '$(PclGameIntroAgent)' == ''" Text="Both PclGameIntroClip and PclGameIntroAgent are required to embed the game-intro resources." />
    <Error Condition="!Exists('$(PclGameIntroClip)') or !Exists('$(PclGameIntroAgent)') or !Exists('$(PclGameIntroAgent).sha256')" Text="A local game-intro preview input or its SHA-256 manifest is missing." />
  </Target>
  <ItemGroup Condition="'$(PclGameIntroClip)' != '' and '$(PclGameIntroAgent)' != ''">
    <EmbeddedResource Include="$(PclGameIntroClip)" LogicalName="PCL3_LaunchIntro.mp4" />
    <EmbeddedResource Include="$(PclGameIntroAgent)" LogicalName="PCL3_LaunchIntroAgent.jar" />
    <EmbeddedResource Include="$(PclGameIntroAgent).sha256" LogicalName="PCL3_LaunchIntroAgent.jar.sha256" />
  </ItemGroup>
</Project>
