<local:MyPageRight x:Class="PCL.PageInstanceBackup"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25">
            <StackPanel x:Name="PanActions" IsEnabled="False">
                <local:MyCard Title="备份设置" Margin="0,0,0,15">
                    <StackPanel Margin="25,40,25,20">
                        <local:MyCheckBox x:Name="CheckAutomatic" Text="启动前自动备份" Height="28" />
                        <TextBlock Text="备份范围" Margin="0,12,0,5" />
                        <local:MyComboBox x:Name="ComboScope" MinHeight="28" AutomationProperties.Name="备份范围" />
                        <TextBlock x:Name="LabSharedData" Text="未开启实例隔离，仅可备份共享游戏目录中的存档。"
                                   TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed" />
                        <TextBlock Text="自动备份保留数量（1–100）" Margin="0,12,0,5" />
                        <local:MyTextBox x:Name="TextRetention" MinHeight="28" AutomationProperties.Name="自动备份保留数量" />
                        <WrapPanel Margin="0,12,0,0">
                            <local:MyButton x:Name="BtnSave" Text="保存设置" Click="Save_Click" Height="32"
                                            MinWidth="110" Margin="0,0,8,5" />
                            <local:MyButton x:Name="BtnCreate" Text="立即备份" Click="Create_Click" Height="32"
                                            MinWidth="110" Margin="0,0,0,5" ColorType="Highlight" />
                        </WrapPanel>
                    </StackPanel>
                </local:MyCard>
                <local:MyCard Title="从备份还原" Margin="0,0,0,15">
                    <StackPanel Margin="25,40,25,20">
                        <local:MyComboBox x:Name="ComboBackups" MinHeight="28" AutomationProperties.Name="现有备份" />
                        <TextBlock x:Name="LabEmpty" Text="此实例尚无备份。" Margin="0,5,0,0" Visibility="Collapsed" />
                        <WrapPanel Margin="0,12,0,0">
                            <local:MyButton x:Name="BtnRestore" Text="原地还原" Click="Restore_Click" Height="32"
                                            MinWidth="110" Margin="0,0,8,5" ColorType="Red" />
                            <local:MyButton x:Name="BtnClone" Text="还原为新实例" Click="Clone_Click" Height="32"
                                            MinWidth="110" Margin="0,0,0,5" />
                        </WrapPanel>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
            <TextBlock x:Name="LabBusy" Text="正在处理备份操作…" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
            <TextBlock x:Name="LabStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
