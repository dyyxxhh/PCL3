<local:MyPageRight x:Class="PCL.PageToolsTorDownload"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="Tor 下载">
                <StackPanel Margin="25,40,25,16">
                    <TextBlock Text="下载链接" Margin="0,0,0,6" />
                    <local:MyTextBox x:Name="TextUrl" MinHeight="28" HintText="HTTP、HTTPS 或 .onion 链接" MaxLength="16384"
                                     AutomationProperties.Name="下载链接" />
                    <TextBlock Text="SHA-256（可选）" Margin="0,12,0,6" />
                    <local:MyTextBox x:Name="TextSha256" MinHeight="28" MaxLength="64" AutomationProperties.Name="SHA-256" />
                    <WrapPanel Margin="0,14,0,4">
                        <local:MyButton x:Name="BtnDownload" Text="选择位置并下载" Height="34" MinWidth="130" Margin="0,0,10,6"
                                        ColorType="Highlight" Click="StartDownload" />
                        <local:MyButton x:Name="BtnCancel" Text="取消下载" Height="34" MinWidth="85" Margin="0,0,0,6"
                                        IsEnabled="False" Click="CancelDownload" />
                    </WrapPanel>
                    <ProgressBar x:Name="BarProgress" Height="6" Margin="0,4,0,8" Maximum="100" Visibility="Collapsed" />
                    <TextBlock x:Name="LabStatus" Text="使用「设置 → Tor 网络」中已保存的网桥。"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
