<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>mcm</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="McmReleaseVersion" Value="$(McmReleaseVersion)" />
    <AssemblyMetadata Include="McmOfflineSelfContained" Value="$(SelfContained)" />
    <AssemblyMetadata Include="McmOfflineSingleFile" Value="$(PublishSingleFile)" />
    <AssemblyMetadata Include="McmOfflineNativeBundle" Value="$(IncludeNativeLibrariesForSelfExtract)" />
    <ProjectReference Include="..\PCL.Core.Shared\PCL.Core.Shared.csproj" />
    <ProjectReference Include="..\PCL.Core.SecretsGenerator\PCL.Core.SecretsGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
